{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "types": [],
    "paths": {
      "@deepseek-ai/cordis": [
        "../deepseek-harness/vendor/cordis/lib/types/index.d.ts"
      ],
      "@deepseek-ai/cordis/*": [
        "../deepseek-harness/vendor/cordis/lib/types/*.d.ts"
      ],
      "@deepseek-ai/schemastery": [
        "../deepseek-harness/vendor/schemastery/lib/types/index.d.ts"
      ],
      "@deepseek-ai/dsh-client-runtime": [
        "../deepseek-harness/packages/client/runtime/lib/types/index.d.ts"
      ],
      "@deepseek-ai/dsh-client-runtime/client": [
        "../deepseek-harness/packages/client/runtime/lib/types/client/index.d.ts"
      ],
      "@deepseek-ai/dsh-client-locale/client": [
        "../deepseek-harness/packages/client/locale/lib/types/client/index.d.ts"
      ],
      "@deepseek-ai/dsh-client-ui-slots": [
        "../deepseek-harness/packages/client/ui-slots/lib/types/index.d.ts"
      ],
      "@deepseek-ai/dsh-client-ui-slots/client": [
        "../deepseek-harness/packages/client/ui-slots/lib/types/client/index.d.ts"
      ],
      "@deepseek-ai/dsh-client-ui-sidebar/client": [
        "../deepseek-harness/packages/client/ui-sidebar/lib/types/client/index.d.ts"
      ],
      "@deepseek-ai/dsh-client-ui-primitives": [
        "../deepseek-harness/packages/client/ui-primitives/lib/types/index.d.ts"
      ],
      "@deepseek-ai/dsh-client-ui-primitives/*": [
        "../deepseek-harness/packages/client/ui-primitives/lib/types/*.d.ts"
      ],
      "@deepseek-ai/dsh-client-connection": [
        "../deepseek-harness/packages/client/connection/lib/types/index.d.ts"
      ],
      "@deepseek-ai/dsh-client-connection/client": [
        "../deepseek-harness/packages/client/connection/lib/types/client/index.d.ts"
      ],
      "@deepseek-ai/dsh-host-apiproxy/api": [
        "../deepseek-harness/packages/host/apiproxy/lib/types/api/index.d.ts"
      ],
      "@deepseek-ai/dsh-host-apiproxy/api/*": [
        "../deepseek-harness/packages/host/apiproxy/lib/types/api/*.d.ts"
      ],
      "@deepseek-ai/dsh-host-apiproxy": [
        "../deepseek-harness/packages/host/apiproxy/lib/types/index.d.ts"
      ]
    }
  },
  "include": [
    "src/client",
    "src/css-modules.d.ts"
  ],
  "exclude": []
}
