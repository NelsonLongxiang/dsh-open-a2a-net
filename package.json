{
  "name": "@nelsonlongxiang/dsh-open-a2a-net",
  "version": "0.6.12",
  "description": "Open A2A network plugin for DeepSeek Harness: signed agent cards, decentralized peer/zone discovery, direct routing model tools, and joinable session nodes with a sidebar control",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets/nexusDist",
    "assets/stageDist",
    "images",
    "README_zh.md",
    "cordis.patch.yml",
    "README.md",
    "nexus-stage/src",
    "nexus-stage/scripts",
    "nexus-stage/package.json",
    "nexus-stage/package-lock.json",
    "nexus-stage/tsconfig.json",
    "nexus-stage/vite.config.ts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "prepare": "pnpm build",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && tsdown && node scripts/copy-skill.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:wire": "vitest run tests/wire",
    "test:mesh": "vitest run tests/mesh",
    "test:live": "vitest run tests/live",
    "test:build-layout": "vitest run tests/gates/build-layout.spec.ts",
    "verify:nexus": "npm --prefix nexus-stage ci --no-audit --no-fund && npm --prefix nexus-stage run build && npm --prefix nexus-stage run test && git diff --exit-code -- assets/nexusDist/assets && git diff --ignore-cr-at-eol --exit-code -- assets/nexusDist/index.html",
    "verify": "pnpm typecheck && pnpm build && pnpm test && pnpm test:build-layout && pnpm verify:nexus"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/cordis-plugin-loader": ">=1.0.2",
    "@deepseek-ai/cordis-plugin-timer": ">=1.1.3",
    "@deepseek-ai/dsh-agent": ">=0.1.7-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": ">=0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-locale": ">=0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.7-alpha.2",
    "@deepseek-ai/dsh-home-paths": ">=0.1.7-alpha.2",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.7-alpha.2",
    "@deepseek-ai/dsh-invariants": ">=0.1.7-alpha.2",
    "@deepseek-ai/dsh-llm": ">=0.1.7-alpha.2",
    "@deepseek-ai/dsh-session": ">=0.1.7-alpha.2",
    "@deepseek-ai/dsh-session-persistence": ">=0.1.7-alpha.2",
    "@deepseek-ai/dsh-session-title": ">=0.1.7-alpha.2",
    "@deepseek-ai/dsh-tools": ">=0.1.7-alpha.2",
    "@deepseek-ai/schemastery": ">=3.18.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/cordis-plugin-loader": {
      "optional": true
    },
    "@deepseek-ai/cordis-plugin-timer": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-sidebar": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-session-controller": {
      "optional": true
    },
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-invariants": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-persistence": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-title": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-store": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.6",
    "@deepseek-ai/dsh-util-code-language": "0.1.7-rc.2",
    "@deepseek-ai/dsh-util-workspace-path": "0.1.2-alpha.2",
    "@shikijs/langs": "^4.5.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.7",
    "anser": "^2.3.5",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "jsdom": "^26.1.0",
    "katex": "^0.19.0",
    "lightningcss": "^1.33.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-core-commonmark": "^2.0.4",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-factory-space": "^2.1.0",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "shiki": "^4.5.0",
    "simple-icons": "^16.35.0",
    "tsdown": "0.22.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "license": "MIT",
  "repository": {
