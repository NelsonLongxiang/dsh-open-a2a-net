<mxfile host="drawio"><diagram name="迁移状态（拟议，待确认）" id="canvas-provenance-migration"><mxGraphModel page="1" pageWidth="1060" pageHeight="720" grid="1"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="#337 review-r1 · 设计状态图（未实现，非运行事实）" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="970" height="35" as="geometry"/></mxCell>
<mxCell id="2" value="旧快照 / 裸 handle&#xa;原字符串与顺序保留&#xa;来源 unknown，不自动确权" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;spacing=8;fillColor=#fff2cc;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="270" height="100" as="geometry"/></mxCell>
<mxCell id="3" value="兼容窗口默认 true&#xa;非暂停 bare 沿用旧推断&#xa;解析次数 + 碰撞告警" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;spacing=8;fillColor=#dae8fc;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="360" y="80" width="290" height="100" as="geometry"/></mxCell>
<mxCell id="4" value="现有路由 / 授权继续&#xa;标记兼容推断，不作删除证据&#xa;暂停先过滤" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;spacing=8;fillColor=#dae8fc;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="710" y="80" width="290" height="100" as="geometry"/></mxCell>
<mxCell id="5" value="leave / archive / local remove&#xa;先保守判定旧推断槽位&#xa;仅证明 local 可精确删除" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;spacing=8;fillColor=#f8cecc;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="260" width="270" height="110" as="geometry"/></mxCell>
<mxCell id="6" value="持久 suspended（逐队/槽位）&#xa;保留原成员，不删除&#xa;任何窗口均不路由/不计入" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;spacing=8;fillColor=#f8cecc;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="360" y="260" width="290" height="110" as="geometry"/></mxCell>
