{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "declarationDir": "lib/types",
    "outDir": "lib",
    "rootDir": "src",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "types": ["node"],
    "ignoreDeprecations": "5.0",
    "baseUrl": ".",
    "paths": {
      "@deepseek-ai/cordis": ["../deepseek-harness/vendor/cordis/lib/types/index.d.ts"],
      "@deepseek-ai/cordis/*": ["../deepseek-harness/vendor/cordis/lib/types/*.d.ts"],
      "@deepseek-ai/cordis-plugin-timer": ["../deepseek-harness/vendor/timer/lib/types/index.d.ts"],
      "@deepseek-ai/cordis-plugin-timer/*": ["../deepseek-harness/vendor/timer/lib/types/*.d.ts"],
      "@deepseek-ai/cordis-plugin-loader": ["../deepseek-harness/vendor/loader/lib/types/index.d.ts"],
      "@deepseek-ai/cordis-plugin-loader/*": ["../deepseek-harness/vendor/loader/lib/types/*.d.ts"],
      "@deepseek-ai/schemastery": ["../deepseek-harness/vendor/schemastery/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-session": ["../deepseek-harness/packages/core/session/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-session/*": ["../deepseek-harness/packages/core/session/lib/types/*.d.ts"],
      "@deepseek-ai/dsh-agent": ["../deepseek-harness/packages/core/agent/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-agent/*": ["../deepseek-harness/packages/core/agent/lib/types/*.d.ts"],
      "@deepseek-ai/dsh-llm": ["../deepseek-harness/packages/llm/llm/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-llm/*": ["../deepseek-harness/packages/llm/llm/lib/types/*.d.ts"],
      "@deepseek-ai/dsh-tools": ["../deepseek-harness/packages/core/tools/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-tools/*": ["../deepseek-harness/packages/core/tools/lib/types/*.d.ts"],
      "@deepseek-ai/dsh-host-webserver": ["../deepseek-harness/packages/host/webserver/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-host-webserver/*": ["../deepseek-harness/packages/host/webserver/lib/types/*.d.ts"],
      "@deepseek-ai/dsh-host-apiproxy": ["../deepseek-harness/packages/host/apiproxy/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-host-apiproxy/*": ["../deepseek-harness/packages/host/apiproxy/lib/types/*.d.ts"],
      "@deepseek-ai/dsh-invariants": ["../deepseek-harness/packages/runtime-diagnostics/invariants/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-invariants/*": ["../deepseek-harness/packages/runtime-diagnostics/invariants/lib/types/*.d.ts"],
      "@deepseek-ai/dsh-home-paths": ["../deepseek-harness/packages/util/home-paths/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-home-paths/*": ["../deepseek-harness/packages/util/home-paths/lib/types/*.d.ts"],
      "@deepseek-ai/dsh-session-persistence": ["../deepseek-harness/packages/session/session-persistence/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-session-persistence/*": ["../deepseek-harness/packages/session/session-persistence/lib/types/*.d.ts"],
      "@deepseek-ai/dsh-session-title": ["../deepseek-harness/packages/session/session-title/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-session-title/*": ["../deepseek-harness/packages/session/session-title/lib/types/*.d.ts"],
      "@deepseek-ai/dsh-system-prompt": ["../deepseek-harness/packages/core/system-prompt/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-system-prompt/*": ["../deepseek-harness/packages/core/system-prompt/lib/types/*.d.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["src/client"]
}
